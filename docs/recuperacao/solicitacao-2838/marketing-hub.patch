diff --git a/frontend/src/pages/productType/ProductTypeDetailPage.test.tsx b/frontend/src/pages/productType/ProductTypeDetailPage.test.tsx
new file mode 100644
index 000000000..f9c76665e
--- /dev/null
+++ b/frontend/src/pages/productType/ProductTypeDetailPage.test.tsx
@@ -0,0 +1,218 @@
+import {
+  cleanup,
+  fireEvent,
+  render,
+  screen,
+  waitFor,
+} from "@testing-library/react";
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { MemoryRouter, Route, Routes } from "react-router-dom";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import axios from "axios";
+import ProductTypeDetailPage from "./ProductTypeDetailPage";
+import ProductTypeCatalogPage from "./ProductTypeCatalogPage";
+
+vi.mock("axios");
+const type = {
+  id: 2,
+  code: "LOW_TICKET_DIGITAL_PRODUCT",
+  name: "Produto low-ticket",
+  internalName: "Quartzo",
+  description: "Pacote digital simples.",
+  aliases: [],
+  status: "ACTIVE",
+  constructionReady: false,
+  missingBlueprintFields: ["Jornada base"],
+  productCount: 3,
+  playProductCount: 1,
+  detailAvailable: true,
+  detailAvailabilityReason: null,
+};
+const detail = {
+  type,
+  guideVersion: "local-v1",
+  scopeNote: "Referência de desenho, sem comprovação de venda.",
+  commonChain: ["Descoberta"],
+  financialCheckpoints: ["Oferta com contribuição positiva"],
+  guide: {
+    purchasedOutcome: "Um pacote utilizável",
+    subprocesses: [
+      {
+        phase: 1,
+        name: "Definir pacote",
+        owner: "Atena",
+        completionEvidence: "Pacote definido",
+      },
+    ],
+    funnels: [
+      {
+        name: "Pacote pronto",
+        whenToUse: "Entrega padronizada",
+        steps: ["Oferta", "Compra", "Entrega"],
+        metrics: ["Uso dos ativos"],
+      },
+    ],
+    differences: [
+      { title: "Custo e margem", description: "Custo do pacote inteiro" },
+    ],
+    guardrails: ["Sem uso ilimitado"],
+  },
+  productsInPlay: [
+    {
+      id: 94003,
+      internalName: "Pacote local",
+      name: "Pacote de teste",
+      funnel: "Funil próprio preservado",
+    },
+  ],
+};
+
+function mount(path = "/product-types/2") {
+  const client = new QueryClient({
+    defaultOptions: { queries: { retry: false }, mutations: { retry: false } },
+  });
+  render(
+    <QueryClientProvider client={client}>
+      <MemoryRouter initialEntries={[path]}>
+        <Routes>
+          <Route
+            path="/product-types/:id"
+            element={<ProductTypeDetailPage />}
+          />
+          <Route path="/product-types" element={<ProductTypeCatalogPage />} />
+        </Routes>
+      </MemoryRouter>
+    </QueryClientProvider>,
+  );
+  return client;
+}
+
+describe("Detalhe comercial de tipo", () => {
+  beforeEach(() => {
+    vi.resetAllMocks();
+  });
+  afterEach(cleanup);
+
+  it("apresenta referência e funil cadastrado separadamente", async () => {
+    vi.mocked(axios.get).mockResolvedValue({ data: detail });
+    mount();
+    expect(
+      await screen.findByRole("heading", { name: "Quartzo" }),
+    ).toBeTruthy();
+    expect(axios.get).toHaveBeenCalledWith("/api/product-types/2/detail");
+    expect(
+      screen.getByRole("heading", { name: "Subprocessos específicos do tipo" }),
+    ).toBeTruthy();
+    expect(
+      screen.getByRole("heading", { name: "Funil de vendas do tipo" }),
+    ).toBeTruthy();
+    expect(screen.getByText("Funil próprio preservado")).toBeTruthy();
+    expect(screen.getAllByText("Não cadastrado").length).toBeGreaterThan(0);
+    expect(
+      screen.getByRole("link", { name: "Ver fichas de execução" }),
+    ).toHaveAttribute("href", "/products/94003/execution-profiles");
+    expect(screen.getByRole("link", { name: "Ver produto" })).toHaveAttribute(
+      "href",
+      "/products/94003/edit",
+    );
+    expect(axios.post).not.toHaveBeenCalled();
+  });
+
+  it("abre pelo card só quando o backend declara elegibilidade", async () => {
+    vi.mocked(axios.get).mockImplementation(async (url) => ({
+      data:
+        url === "/api/product-types/2/detail"
+          ? detail
+          : [
+              type,
+              {
+                ...type,
+                id: 4,
+                internalName: "Fluorita",
+                name: "Consultor",
+                detailAvailable: false,
+                playProductCount: 0,
+                detailAvailabilityReason: "Este tipo não tem produtos em PLAY.",
+              },
+            ],
+    }));
+    mount("/product-types");
+    fireEvent.click(
+      await screen.findByRole("link", { name: "Ver detalhes de Quartzo" }),
+    );
+    expect(
+      await screen.findByRole("heading", { name: "Quartzo" }),
+    ).toBeTruthy();
+    fireEvent.click(
+      screen.getByRole("link", { name: "Voltar aos tipos de produto" }),
+    );
+    expect(
+      await screen.findByText("Este tipo não tem produtos em PLAY."),
+    ).toBeTruthy();
+    expect(
+      screen.queryByRole("link", { name: "Ver detalhes de Fluorita" }),
+    ).toBeNull();
+  });
+
+  it("recupera falha com botão bloqueado durante a consulta", async () => {
+    let finish: (value: unknown) => void = () => {};
+    vi.mocked(axios.get)
+      .mockRejectedValueOnce({ response: { status: 503 } })
+      .mockImplementationOnce(
+        () =>
+          new Promise((resolve) => {
+            finish = resolve;
+          }),
+      );
+    mount();
+    expect(screen.getByRole("status")).toBeTruthy();
+    fireEvent.click(
+      await screen.findByRole("button", { name: "Tentar novamente" }),
+    );
+    await waitFor(() =>
+      expect(
+        screen.getByRole("button", { name: "Carregando..." }),
+      ).toBeDisabled(),
+    );
+    finish({ data: detail });
+    expect(
+      await screen.findByRole("heading", { name: "Quartzo" }),
+    ).toBeTruthy();
+  });
+
+  it.each([
+    [404, "Tipo de produto não encontrado."],
+    [409, "Detalhe indisponível:"],
+  ])("explica resposta %s", async (status, message) => {
+    vi.mocked(axios.get).mockRejectedValue({ response: { status } });
+    mount();
+    expect(await screen.findByRole("alert")).toHaveTextContent(String(message));
+    expect(
+      screen.queryByRole("heading", { name: "Funil de vendas do tipo" }),
+    ).toBeNull();
+  });
+
+  it.each(["abc", "0", "-1", "9007199254740993"])(
+    "não consulta identificador inválido %s",
+    (id) => {
+      mount(`/product-types/${id}`);
+      expect(screen.getByRole("alert")).toHaveTextContent(
+        "Identificador de tipo inválido",
+      );
+      expect(axios.get).not.toHaveBeenCalled();
+    },
+  );
+
+  it("oculta dados antigos se a revalidação constatar ausência de PLAY", async () => {
+    vi.mocked(axios.get)
+      .mockResolvedValueOnce({ data: detail })
+      .mockRejectedValueOnce({ response: { status: 409 } });
+    const client = mount();
+    await screen.findByRole("heading", { name: "Quartzo" });
+    await client.invalidateQueries({ queryKey: ["product-types"] });
+    expect(await screen.findByRole("alert")).toHaveTextContent(
+      "Detalhe indisponível",
+    );
+    expect(screen.queryByText("Funil próprio preservado")).toBeNull();
+  });
+});
