   constructionReady: boolean;
   missingBlueprintFields: string[];
   productCount: number;
+  playProductCount: number;
+  detailAvailable: boolean;
+  detailAvailabilityReason?: string | null;
   createdAt?: string;
   updatedAt?: string;
 }
 
+export interface ProductTypeDetail {
+  type: ProductTypeDefinition;
+  guideVersion: string;
+  scopeNote: string;
+  commonChain: string[];
+  financialCheckpoints: string[];
+  guide: {
+    purchasedOutcome: string;
+    subprocesses: {
+      phase: number;
+      name: string;
+      owner: string;
+      completionEvidence: string;
+    }[];
+    funnels: {
+      name: string;
+      whenToUse: string;
+      steps: string[];
+      metrics: string[];
+    }[];
+    differences: { title: string; description: string }[];
+    guardrails: string[];
+  };
+  productsInPlay: {
+    id: number;
+    name?: string | null;
+    internalName?: string | null;
+    commercialStatus?: string | null;
+    productFormat?: string | null;
+    deliveryMode?: string | null;
+    revenueModel?: string | null;
+    valueUnit?: string | null;
+    valueEvidenceMetric?: string | null;
+    funnel?: string | null;
+  }[];
+}
+
+export function useProductTypeDetail(id: number) {
+  return useQuery({
+    queryKey: ["product-types", "detail", id],
+    enabled: Number.isSafeInteger(id) && id > 0,
+    retry: false,
+    queryFn: async () => {
+      const { data } = await axios.get<ProductTypeDetail>(
+        `/api/product-types/${id}/detail`,
+      );
+      return data;
+    },
+  });
+}
