+package com.marketinghub.producttype.service.detail;
+
+import com.marketinghub.producttype.service.catalog.ProductTypeCatalogItemResponse;
+import java.util.List;
+
+/** Responsabilidade: separar a referência comercial do tipo dos produtos atualmente em PLAY. */
+public record ProductTypeDetailResponse(
+    ProductTypeCatalogItemResponse type,
+    String guideVersion,
+    String scopeNote,
+    List<String> commonChain,
+    List<String> financialCheckpoints,
+    OperatingGuide guide,
+    List<PlayProduct> productsInPlay) {
+
+  /** Referência de desenho do tipo; não representa execução nem autorização comercial. */
+  public record OperatingGuide(
+      String purchasedOutcome,
+      List<Subprocess> subprocesses,
+      List<Funnel> funnels,
+      List<Difference> differences,
+      List<String> guardrails) {}
+
+  /** Trabalho especializado associado à posição de um dos seis processos comuns. */
+  public record Subprocess(int phase, String name, String owner, String completionEvidence) {}
+
+  /** Variante comercial e condição de aplicação, sem selecionar o funil de uma execução. */
+  public record Funnel(String name, String whenToUse, List<String> steps, List<String> metrics) {}
+
+  /** Diferença relevante para valor, comunicação, entrega ou economia do tipo. */
+  public record Difference(String title, String description) {}
+
+  /** Dados cadastrados do produto; campos ausentes não são inferidos pelo mineral. */
+  public record PlayProduct(
+      Long id,
+      String name,
+      String internalName,
+      String commercialStatus,
+      String productFormat,
+      String deliveryMode,
+      String revenueModel,
+      String valueUnit,
+      String valueEvidenceMetric,
+      String funnel) {}
+}
