@@ -0,0 +1,156 @@
+package com.marketinghub.producttype.service.detail;
+
+import static org.assertj.core.api.Assertions.*;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.*;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.marketinghub.producttype.controller.ProductTypeController;
+import com.marketinghub.producttype.service.ProductTypeOperatingGuides;
+import java.util.List;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.setup.MockMvcBuilders;
+
+/** Responsabilidade: validar o detalhe ponta a ponta entre HTTP, serviço, guia e SQL de PLAY. */
+class ProductTypeDetailTest {
+  private ProductTypeDetailFixture fixture;
+  private MockMvc mvc;
+
+  /** Reinicia dados isolados e conecta o controller aos serviços reais antes de cada cenário. */
+  @BeforeEach
+  void prepare() {
+    fixture = new ProductTypeDetailFixture();
+    mvc = MockMvcBuilders.standaloneSetup(new ProductTypeController(fixture.service)).build();
+  }
+
+  /** Confere elegibilidade calculada em SQL, inclusive legado nulo e tipo ACTIVE sem PLAY. */
+  @Test
+  void catalogUsesPlayInsteadOfTypeOrCommercialStatus() throws Exception {
+    mvc.perform(get("/api/product-types"))
+        .andExpect(status().isOk())
+        .andExpect(jsonPath("$[0].productCount").value(3))
+        .andExpect(jsonPath("$[0].playProductCount").value(2))
+        .andExpect(jsonPath("$[0].detailAvailable").value(true))
+        .andExpect(jsonPath("$[3].productCount").value(1))
+        .andExpect(jsonPath("$[3].playProductCount").value(0))
+        .andExpect(jsonPath("$[3].detailAvailable").value(false));
+  }
+
+  /** Garante detalhe real para os três tipos aprovados sem expor STOP nem outro tipo. */
+  @Test
+  void detailHasSpecificGuideAndOnlyMatchingProducts() throws Exception {
+    for (long id : List.of(1L, 2L, 3L)) {
+      var result = fixture.service.detail(id);
+      assertThat(result.guide().subprocesses()).hasSize(6);
+      assertThat(result.guide().funnels()).hasSize(2);
+      assertThat(result.financialCheckpoints()).hasSize(4);
+      assertThat(result.guide().differences()).hasSize(6);
+      assertThat(result.productsInPlay())
+          .extracting(ProductTypeDetailResponse.PlayProduct::id)
+          .doesNotContain(94005L, 94006L);
+      mvc.perform(get("/api/product-types/{id}/detail", id))
+          .andExpect(status().isOk())
+          .andExpect(jsonPath("$.type.id").value(id))
+          .andExpect(jsonPath("$.guideVersion").value("product-type-operating-guides-v1"));
+    }
+    assertThat(fixture.service.detail(2L).productsInPlay())
+        .extracting(ProductTypeDetailResponse.PlayProduct::id)
+        .containsExactly(94003L);
+    assertThat(fixture.service.detail(3L).productsInPlay())
+        .extracting(ProductTypeDetailResponse.PlayProduct::id)
+        .containsExactly(94004L);
+  }
+
+  /** Preserva dados ausentes e funil cadastrado, sem substituir pelo guia do mineral. */
+  @Test
+  void preservesRegisteredFunnelAndMissingData() {
+    var products = fixture.service.detail(1L).productsInPlay();
+    assertThat(products)
+        .anySatisfy(
+            p -> {
+              assertThat(p.id()).isEqualTo(94001L);
+              assertThat(p.funnel()).isEqualTo("Entrada local → compra → aplicação");
+              assertThat(p.productFormat()).isNull();
+            })
+        .anySatisfy(
+            p -> {
+              assertThat(p.id()).isEqualTo(94002L);
+              assertThat(p.funnel()).isNull();
+            });
+  }
+
+  /** Revoga o detalhe e o link quando o último produto entrar em STOP. */
+  @Test
+  void stopIsReevaluatedWithoutServingOldEligibility() throws Exception {
+    fixture.jdbc.update(
+        "UPDATE product SET automatic_execution_enabled = FALSE WHERE product_type_id = 2");
+    assertThat(fixture.service.get(2L).detailAvailable()).isFalse();
+    mvc.perform(get("/api/product-types/2/detail")).andExpect(status().isConflict());
+  }
+
+  /** Não inventa um guia genérico quando um tipo fora do escopo passar a ter PLAY. */
+  @Test
+  void playDoesNotInventUnspecifiedGuide() throws Exception {
+    fixture.jdbc.update(
+        "UPDATE product SET automatic_execution_enabled = TRUE WHERE product_type_id = 4");
+    var type = fixture.service.get(4L);
+    assertThat(type.playProductCount()).isEqualTo(1);
+    assertThat(type.detailAvailable()).isFalse();
+    assertThat(type.detailAvailabilityReason()).contains("guia");
+    mvc.perform(get("/api/product-types/4/detail")).andExpect(status().isConflict());
+  }
+
+  /** Trata identificador inválido e inexistente pelo contrato HTTP, sem conteúdo de outro tipo. */
+  @Test
+  void rejectsInvalidAndUnknownIds() throws Exception {
+    mvc.perform(get("/api/product-types/abc/detail")).andExpect(status().isBadRequest());
+    mvc.perform(get("/api/product-types/999999/detail")).andExpect(status().isNotFound());
+    mvc.perform(get("/api/product-types/0/detail")).andExpect(status().isNotFound());
+  }
+
+  /**
+   * Confere que o recurso versionado cobre só o escopo aprovado com fases e contratos completos.
+   */
+  @Test
+  void referenceContractIsCompleteAndDoesNotClaimMeasuredSales() {
+    var catalog = new ProductTypeOperatingGuides(new ObjectMapper()).catalog();
+    assertThat(catalog.types()).containsOnlyKeys("PDE", "LOW_TICKET_DIGITAL_PRODUCT", "AI_PRODUCT");
+    assertThat(catalog.commonChain()).hasSize(6);
+    assertThat(catalog.scopeNote()).contains("não comprova execução");
+    catalog
+        .types()
+        .values()
+        .forEach(
+            guide -> {
+              assertThat(guide.subprocesses())
+                  .extracting(ProductTypeDetailResponse.Subprocess::phase)
+                  .containsExactly(1, 2, 3, 4, 5, 6);
+              guide
+                  .subprocesses()
+                  .forEach(
+                      step -> {
+                        assertThat(step.owner()).isNotBlank();
+                        assertThat(step.completionEvidence()).isNotBlank();
+                      });
+              guide
+                  .funnels()
+                  .forEach(
+                      funnel -> {
+                        assertThat(funnel.whenToUse()).isNotBlank();
+                        assertThat(funnel.steps()).isNotEmpty();
+                        assertThat(funnel.metrics()).isNotEmpty();
+                      });
+              assertThat(guide.guardrails()).isNotEmpty();
+            });
+  }
+
+  /** Um erro de SQL deve falhar visivelmente, nunca simular catálogo sem produtos. */
+  @Test
+  void databaseFailureDoesNotBecomeFalseEmptySuccess() {
+    fixture.jdbc.execute("DROP TABLE product");
+    assertThatThrownBy(() -> fixture.service.detail(1L))
+        .isInstanceOf(org.springframework.dao.DataAccessException.class);
+  }
+}
