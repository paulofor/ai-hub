+#!/usr/bin/env python3
+"""Executa a matriz local do detalhe, preservando evidências e removendo serviços temporários."""
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+import sys
+import time
+import urllib.request
+
+ROOT = Path(__file__).resolve().parents[3]
+MODULE = ROOT / 'backend/ads-service'
+ROUND = sys.argv[1] if len(sys.argv) == 2 else 'round-1'
+if not re.fullmatch(r'round-[1-9][0-9]*', ROUND):
+    raise SystemExit('Informe round-N.')
+PROJECT = os.environ.get('PRODUCT_TYPE_COMPOSE_PROJECT', '')
+if not re.fullmatch(r'aihub-[a-f0-9-]+', PROJECT):
+    raise SystemExit('Defina PRODUCT_TYPE_COMPOSE_PROJECT com o projeto exclusivo autorizado da sandbox.')
+OUT = ROOT / 'artifacts/product-type-detail' / ROUND
+OUT.mkdir(parents=True, exist_ok=True)
+COMPOSE = ['docker', 'compose', '-p', PROJECT, '-f', str(ROOT / 'infra/testing/product-type-detail/compose.yml')]
+DB = 'jdbc:mysql://sandbox-docker:18415/product_type_detail_local?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC'
+JAVA = None
+
+
+def run(name, args, cwd=ROOT, extra_env=None):
+    """Registra saída de uma etapa e interrompe a rodada se houver falha."""
+    print(name, flush=True)
+    env = os.environ.copy()
+    env.update(extra_env or {})
+    with (OUT / (name + '.log')).open('w') as log:
+        result = subprocess.run(args, cwd=cwd, env=env, stdout=log, stderr=subprocess.STDOUT)
+    if result.returncode:
+        print((OUT / (name + '.log')).read_text()[-4000:], flush=True)
+        raise RuntimeError(name + ' falhou')
+
+
+try:
+    for name, command in [('docker', ['docker', 'version']), ('buildx', ['docker', 'buildx', 'version']), ('compose', ['docker', 'compose', 'version'])]:
+        run(name, command)
+    run('mysql-up', COMPOSE + ['up', '-d', '--wait'])
+    run('backend', ['mvn', '-Dtest=ProductType*Test,ProductRepositoryTest,ProductControllerTest,ProductServiceTest,ArquiteturaTest', 'test'], MODULE)
+    run('mysql', ['mvn', '-Dtest=ProductTypeDetailTest', '-Dtype.detail.mysql.url=' + DB, 'test'], MODULE)
+    run('classpath', ['mvn', '-q', 'dependency:build-classpath', '-Dmdep.includeScope=test', '-Dmdep.outputFile=target/type-detail-classpath.txt'], MODULE)
+    run('typecheck', ['npm', 'run', 'typecheck'], ROOT / 'frontend')
+    run('frontend', ['npm', 'test', '--', '--run', 'src/pages/productType', 'src/pages/product/ProductForm.test.tsx', 'src/pages/product/ProductListPage.test.tsx', 'src/components/MainNavigation.test.tsx', 'src/config/api.test.ts', '--maxWorkers=2', '--minWorkers=1'], ROOT / 'frontend')
+    run('build', ['npm', 'run', 'build'], ROOT / 'frontend', {'VITE_API_URL': ''})
