+package com.marketinghub.producttype.service;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.marketinghub.producttype.service.detail.ProductTypeDetailResponse.OperatingGuide;
+import com.marketinghub.producttype.service.detail.ProductTypeGuideCatalog;
+import java.io.IOException;
+import java.util.Optional;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.core.io.ClassPathResource;
+import org.springframework.stereotype.Component;
+
+/**
+ * Responsabilidade: carregar a referência comercial versionada sem inferir execução de produtos.
+ */
+@Component
+public class ProductTypeOperatingGuides {
+  private static final Logger log = LoggerFactory.getLogger(ProductTypeOperatingGuides.class);
+  private final ProductTypeGuideCatalog catalog;
+
+  /** Carrega o recurso canônico e impede inicialização com guia ilegível. */
+  public ProductTypeOperatingGuides(ObjectMapper mapper) {
+    String path = "product-types/operating-guides.v1.json";
+    try (var stream = new ClassPathResource(path).getInputStream()) {
+      catalog = mapper.readValue(stream, ProductTypeGuideCatalog.class);
+    } catch (IOException ex) {
+      log.error("producttype operação=carregarGuias recurso={}", path, ex);
+      throw new IllegalStateException(
+          "Não foi possível carregar os guias dos tipos de produto.", ex);
+    }
+  }
+
+  /** Retorna somente os tipos cujo guia foi definido nesta versão. */
+  public Optional<OperatingGuide> find(String code) {
+    return Optional.ofNullable(catalog.types().get(code));
+  }
+
+  /** Entrega metadados comuns, mantendo a fonte de conteúdo no backend. */
+  public ProductTypeGuideCatalog catalog() {
+    return catalog;
+  }
+}
