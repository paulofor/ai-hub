+package com.marketinghub.repository.jdbc.producttype;
+
+import com.marketinghub.producttype.service.detail.ProductTypeDetailResponse.PlayProduct;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.stereotype.Repository;
+
+/** Responsabilidade: consultar uso operacional dos tipos com filtros aplicados no banco. */
+@Repository
+public class ProductTypeReadRepository {
+  private final JdbcTemplate jdbc;
+
+  /** Recebe a conexão administrada pelo backend principal. */
+  public ProductTypeReadRepository(JdbcTemplate jdbc) {
+    this.jdbc = jdbc;
+  }
+
+  /**
+   * Conta PLAY por tipo em uma consulta, incluindo o nulo legado previsto no controle operacional.
+   */
+  public Map<Long, Long> countInPlayByType() {
+    Map<Long, Long> counts = new LinkedHashMap<>();
+    jdbc.query(
+        """
+        SELECT product_type_id, COUNT(*) AS play_count FROM product
+        WHERE product_type_id IS NOT NULL
+          AND (automatic_execution_enabled = TRUE OR automatic_execution_enabled IS NULL)
+        GROUP BY product_type_id
+        """,
+        (org.springframework.jdbc.core.RowCallbackHandler)
+            row -> counts.put(row.getLong("product_type_id"), row.getLong("play_count")));
+    return counts;
+  }
+
+  /** Consulta apenas os produtos em PLAY do tipo solicitado, sem hidratar dados de outros tipos. */
+  public List<PlayProduct> findInPlay(Long typeId) {
+    return jdbc.query(
+        """
+        SELECT id, name, internal_name, commercial_status, product_format, delivery_mode,
+          revenue_model, value_unit, value_evidence_metric, funnel
+        FROM product WHERE product_type_id = ?
+          AND (automatic_execution_enabled = TRUE OR automatic_execution_enabled IS NULL)
+        ORDER BY internal_name, id
+        """,
+        (row, index) ->
+            new PlayProduct(
+                row.getLong("id"),
+                row.getString("name"),
+                row.getString("internal_name"),
+                row.getString("commercial_status"),
+                row.getString("product_format"),
+                row.getString("delivery_mode"),
+                row.getString("revenue_model"),
+                row.getString("value_unit"),
+                row.getString("value_evidence_metric"),
+                row.getString("funnel")),
+        typeId);
+  }
+}
