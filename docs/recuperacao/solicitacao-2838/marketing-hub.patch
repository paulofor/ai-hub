@@ -0,0 +1,361 @@
+import { Link, useParams } from "react-router-dom";
+import { useProductTypeDetail } from "../../api/productType/useProductTypes";
+import PageTitle from "../../components/PageTitle";
+import "./ProductTypeDetailPage.css";
+
+const statusLabels = {
+  PROPOSED: "Em avaliação",
+  ACTIVE: "Em uso",
+  RETIRED: "Aposentado",
+};
+
+function Field({ label, value }: { label: string; value?: string | null }) {
+  return (
+    <div className="col-12 col-md-6">
+      <dt>{label}</dt>
+      <dd className="text-muted type-detail-text">
+        {value?.trim() || "Não cadastrado"}
+      </dd>
+    </div>
+  );
+}
+
+export default function ProductTypeDetailPage() {
+  const { id } = useParams();
+  const typeId = Number(id);
+  const validId = Number.isSafeInteger(typeId) && typeId > 0;
+  const query = useProductTypeDetail(typeId);
+  const back = (
+    <Link to="/product-types" className="btn btn-outline-secondary">
+      Voltar aos tipos de produto
+    </Link>
+  );
+
+  if (!validId) {
+    return (
+      <div>
+        <PageTitle>Tipo de produto</PageTitle>
+        <p role="alert">Identificador de tipo inválido.</p>
+        {back}
+      </div>
+    );
+  }
+  if (query.isLoading && query.errorUpdatedAt === 0) {
+    return <p role="status">Carregando detalhes do tipo...</p>;
+  }
+  if (query.isError || !query.data) {
+    const status = (query.error as { response?: { status?: number } })?.response
+      ?.status;
+    return (
+      <div>
+        <PageTitle>Tipo de produto</PageTitle>
+        <div className="alert alert-warning" role="alert">
+          {status === 404
+            ? "Tipo de produto não encontrado."
+            : status === 409
+              ? "Detalhe indisponível: este tipo precisa de produtos em PLAY e de um guia definido. Consulte o catálogo atualizado."
+              : "Não foi possível carregar os detalhes do tipo. Tente novamente."}
+        </div>
+        <div className="d-flex flex-wrap gap-2">
+          {back}
+          <button
+            type="button"
+            className="btn btn-primary"
+            disabled={query.isFetching}
+            onClick={() => void query.refetch()}
+          >
+            {query.isFetching && (
+              <span
+                className="spinner-border spinner-border-sm me-2"
+                aria-hidden="true"
+              />
+            )}
+            {query.isFetching ? "Carregando..." : "Tentar novamente"}
+          </button>
+        </div>
+      </div>
+    );
+  }
+
+  const { type, guide, commonChain, productsInPlay, financialCheckpoints } =
+    query.data;
+  return (
+    <div className="product-type-detail">
+      <header className="d-flex flex-wrap justify-content-between gap-3 mb-4">
+        <div>
+          <p className="text-muted mb-1">
+            Tipo de produto · {statusLabels[type.status]}
+          </p>
+          <PageTitle>{type.internalName || type.name}</PageTitle>
+          <p className="mb-2">{type.name}</p>
+          <div className="d-flex flex-wrap gap-2">
+            <span className="badge text-bg-success">
+              {type.playProductCount} produto
+              {type.playProductCount === 1 ? "" : "s"} em PLAY
+            </span>
+            <span className="badge text-bg-light border">
+              {type.productCount} produto
+              {type.productCount === 1 ? " vinculado" : "s vinculados"}
+            </span>
+          </div>
+        </div>
+        <div>{back}</div>
+      </header>
+
+      <nav aria-label="Seções do tipo" className="d-flex flex-wrap gap-3 mb-4">
+        <a href="#dados-basicos">Dados básicos</a>
+        <a href="#subprocessos">Subprocessos</a>
+        <a href="#funil">Funil de vendas</a>
+        <a href="#diferencas">Diferenças e margem</a>
+        <a href="#produtos-play">Produtos em PLAY</a>
+      </nav>
+
+      <section
+        id="dados-basicos"
+        aria-labelledby="dados-title"
+        className="card mb-4"
+      >
+        <div className="card-body">
+          <h2 id="dados-title" className="h4">
+            Dados básicos
+          </h2>
+          <p>{type.description || "Descrição ainda não cadastrada."}</p>
+          <dl className="row mb-0">
+            <Field label="Código do catálogo" value={type.code} />
+            <Field label="Apelidos internos" value={type.aliases.join(", ")} />
+          </dl>
+          <h3 className="h6">Resultado comprado — referência do tipo</h3>
+          <p className="mb-0">{guide.purchasedOutcome}</p>
+          <details className="mt-3">
+            <summary className="fw-semibold">
+              Base de construção cadastrada
+            </summary>
+            <p className="mt-2">
+              {type.constructionReady ? "Base pronta." : "Base incompleta."}
+              {!type.constructionReady &&
+                type.missingBlueprintFields.length > 0 &&
+                ` Faltam: ${type.missingBlueprintFields.join(", ")}.`}
+            </p>
+            <dl className="row mb-0">
+              <Field label="Versão da base" value={type.blueprint?.version} />
+              <Field
+                label="Canal principal"
+                value={type.blueprint?.primaryChannel}
