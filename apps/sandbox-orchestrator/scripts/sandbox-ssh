#!/bin/sh
set -eu

usage() {
  echo "Uso: sandbox-ssh <usuario@host-autorizado> <comando-remoto> [argumentos...]" >&2
  exit 64
}

[ "$#" -ge 2 ] || usage

destination="$1"
shift

allowed_destinations="$(printf '%s' "${SANDBOX_SSH_ALLOWED_DESTINATIONS:-}" | tr ',' ' ')"
destination_allowed=false
for allowed_destination in ${allowed_destinations}; do
  if [ "${destination}" = "${allowed_destination}" ]; then
    destination_allowed=true
    break
  fi
done

if [ "${destination_allowed}" != "true" ]; then
  echo "sandbox-ssh: destino não autorizado: ${destination}" >&2
  exit 77
fi

socket_path="${SSH_AUTH_SOCK:-/run/sandbox-ssh-agent/agent.sock}"
known_hosts_file="${SANDBOX_SSH_KNOWN_HOSTS_FILE:-/etc/sandbox-ssh/known_hosts}"
public_key_file="${SANDBOX_SSH_PUBLIC_KEY_FILE:-/etc/sandbox-ssh/operator_key.pub}"
connect_timeout="${SANDBOX_SSH_CONNECT_TIMEOUT_SECONDS:-15}"

case "${connect_timeout}" in
  ''|*[!0-9]*)
    echo "sandbox-ssh: timeout de conexão inválido" >&2
    exit 78
    ;;
esac

if [ ! -S "${socket_path}" ]; then
  echo "sandbox-ssh: agente SSH indisponível" >&2
  exit 69
fi

destination_host="${destination#*@}"
if ! ssh-keygen -F "${destination_host}" -f "${known_hosts_file}" >/dev/null; then
  echo "sandbox-ssh: host key não fixada para ${destination_host}" >&2
  exit 77
fi

exec /usr/bin/ssh \
  -F /dev/null \
  -o "IdentityAgent=${socket_path}" \
  -o "IdentityFile=${public_key_file}" \
  -o IdentitiesOnly=yes \
  -o "UserKnownHostsFile=${known_hosts_file}" \
  -o GlobalKnownHostsFile=/dev/null \
  -o StrictHostKeyChecking=yes \
  -o BatchMode=yes \
  -o PasswordAuthentication=no \
  -o KbdInteractiveAuthentication=no \
  -o PreferredAuthentications=publickey \
  -o NumberOfPasswordPrompts=0 \
  -o ForwardAgent=no \
  -o ClearAllForwardings=yes \
  -o RequestTTY=no \
  -o PermitLocalCommand=no \
  -o "ConnectTimeout=${connect_timeout}" \
  -o ServerAliveInterval=30 \
  -o ServerAliveCountMax=3 \
  -- "${destination}" "$@"
